# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API / API Keys).
#
# Both Supabase values are PUBLIC by design (they are shipped to the browser).
# Security comes from the Row Level Security policies in supabase/migrations,
# not from hiding these values.
#
# NEVER put the `service_role` / secret key in this file or anywhere in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Either the legacy "anon" key or the newer "publishable" key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: the public address of the deployed site (no trailing slash).
# Used for link-preview images in WhatsApp/iMessage/etc.
VITE_SITE_URL=

# Leave the two Supabase values empty to run the site in DEMO MODE with
# clearly-labelled placeholder content.
